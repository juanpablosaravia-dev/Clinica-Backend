    {
      "name": "Agenda medica (medico/operador)",
      "description": "Requiere haber corrido antes 'POST /auth/login - medico' y 'POST /auth/login - operador' en la carpeta Autenticacion. El medico solo puede gestionar su propia agenda (id_medico = {{medicoId}}); el operador puede gestionar la de cualquiera.",
      "item": [
        {
          "name": "GET /agenda - rol paciente (403)",
          "event": [
            {
              "listen": "test",
              "script": { "type": "text/javascript", "exec": ["pm.test('Responde 403', () => pm.response.to.have.status(403));"] }
            }
          ],
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": "{{baseUrl}}/agenda"
          }
        },
        {
          "name": "POST /agenda - operador (201, guarda {{agendaId}})",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const cuerpo = pm.response.json();",
                  "pm.test('Responde 201', () => pm.response.to.have.status(201));",
                  "if (cuerpo.datos && cuerpo.datos.id) {",
                  "  pm.collectionVariables.set('agendaId', cuerpo.datos.id);",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{tokenOperador}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"hora_entrada\": \"09:00\",\n  \"hora_salida\": \"13:00\",\n  \"fecha\": \"2026-09-01\",\n  \"id_medico\": {{medicoId}},\n  \"id_especialidad\": 1,\n  \"id_sede\": 1\n}"
            },
            "url": "{{baseUrl}}/agenda"
          }
        },
        {
          "name": "POST /agenda - medico intenta cargar agenda de otro medico (403)",
          "event": [
            {
              "listen": "test",
              "script": { "type": "text/javascript", "exec": ["pm.test('Responde 403', () => pm.response.to.have.status(403));"] }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{tokenMedico}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"hora_entrada\": \"09:00\",\n  \"hora_salida\": \"13:00\",\n  \"fecha\": \"2026-09-01\",\n  \"id_medico\": 99,\n  \"id_especialidad\": 1,\n  \"id_sede\": 1\n}"
            },
            "url": "{{baseUrl}}/agenda"
          }
        },
        {
          "name": "GET /agenda - filtrado por medico y fecha (200)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Responde 200', () => pm.response.to.have.status(200));",
                  "pm.test('Formato uniforme', () => {",
                  "  const cuerpo = pm.response.json();",
                  "  pm.expect(cuerpo).to.have.all.keys('codigo', 'estado', 'datos');",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{tokenOperador}}" }],
            "url": "{{baseUrl}}/agenda?id_medico={{medicoId}}&fecha=2026-09-01"
          }
        },
        {
          "name": "PUT /agenda/{{agendaId}} - operador (200)",
          "event": [
            {
              "listen": "test",
              "script": { "type": "text/javascript", "exec": ["pm.test('Responde 200', () => pm.response.to.have.status(200));"] }
            }
          ],
          "request": {
            "method": "PUT",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{tokenOperador}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"hora_entrada\": \"10:00\",\n  \"hora_salida\": \"14:00\",\n  \"fecha\": \"2026-09-01\",\n  \"id_medico\": {{medicoId}},\n  \"id_especialidad\": 1,\n  \"id_sede\": 1\n}"
            },
            "url": "{{baseUrl}}/agenda/{{agendaId}}"
          }
        },
        {
          "name": "DELETE /agenda/{{agendaId}} - operador (200)",
          "event": [
            {
              "listen": "test",
              "script": { "type": "text/javascript", "exec": ["pm.test('Responde 200', () => pm.response.to.have.status(200));"] }
            }
          ],
          "request": {
            "method": "DELETE",
            "header": [{ "key": "Authorization", "value": "Bearer {{tokenOperador}}" }],
            "url": "{{baseUrl}}/agenda/{{agendaId}}"
          }
        }
      ]
    }
