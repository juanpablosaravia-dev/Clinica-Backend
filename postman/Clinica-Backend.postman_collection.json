{
  "info": {
    "name": "Clinica-Backend - Semana 1",
    "description": "Coleccion de pruebas de la Semana 1: GET /health, GET /coberturas, POST /auth/registro, POST /auth/login y el endpoint protegido GET /auth/perfil (verificarToken).\n\nOrden sugerido: correr 'POST /auth/registro - exito' y luego 'POST /auth/login - exito', que guarda el JWT en la variable de coleccion {{token}} para los endpoints protegidos.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:3000" },
    { "key": "token", "value": "" }
  ],
  "item": [
    {
      "name": "GET /health",
      "request": {
        "method": "GET",
        "url": "{{baseUrl}}/health"
      }
    },
    {
      "name": "GET /coberturas",
      "request": {
        "method": "GET",
        "url": "{{baseUrl}}/coberturas"
      }
    },
    {
      "name": "POST /auth/registro - exito",
      "request": {
        "method": "POST",
        "header": [
          { "key": "Content-Type", "value": "application/json" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"nombre\": \"Pedro\",\n  \"apellido\": \"Soria\",\n  \"dni\": \"36000961\",\n  \"email\": \"pedro@example.com\",\n  \"password\": \"Admin123\",\n  \"fecha_nacimiento\": \"1998-03-14\",\n  \"id_cobertura\": 1\n}"
        },
        "url": "{{baseUrl}}/auth/registro"
      }
    },
    {
      "name": "POST /auth/registro - DNI/Email duplicado",
      "request": {
        "method": "POST",
        "header": [
          { "key": "Content-Type", "value": "application/json" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"nombre\": \"Pedro\",\n  \"apellido\": \"Soria\",\n  \"dni\": \"36000961\",\n  \"email\": \"pedro@example.com\",\n  \"password\": \"Admin123\",\n  \"fecha_nacimiento\": \"1998-03-14\",\n  \"id_cobertura\": 1\n}"
        },
        "url": "{{baseUrl}}/auth/registro"
      }
    },
    {
      "name": "POST /auth/registro - falta campo requerido",
      "request": {
        "method": "POST",
        "header": [
          { "key": "Content-Type", "value": "application/json" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"nombre\": \"Pedro\",\n  \"apellido\": \"Soria\",\n  \"dni\": \"36000962\",\n  \"password\": \"Admin123\",\n  \"fecha_nacimiento\": \"1998-03-14\",\n  \"id_cobertura\": 1\n}"
        },
        "url": "{{baseUrl}}/auth/registro"
      }
    },
    {
      "name": "POST /auth/login - exito (guarda {{token}})",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "const cuerpo = pm.response.json();",
              "",
              "pm.test('Responde 200', () => pm.response.to.have.status(200));",
              "pm.test('Formato uniforme { codigo, estado, datos }', () => {",
              "  pm.expect(cuerpo).to.have.all.keys('codigo', 'estado', 'datos');",
              "  pm.expect(cuerpo.codigo).to.eql(200);",
              "  pm.expect(cuerpo.estado).to.eql('ok');",
              "});",
              "pm.test('Devuelve un token', () => pm.expect(cuerpo.datos.token).to.be.a('string').and.not.empty);",
              "",
              "if (cuerpo.datos && cuerpo.datos.token) {",
              "  pm.collectionVariables.set('token', cuerpo.datos.token);",
              "}"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          { "key": "Content-Type", "value": "application/json" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"pedro@example.com\",\n  \"password\": \"Admin123\"\n}"
        },
        "url": "{{baseUrl}}/auth/login"
      }
    },
    {
      "name": "POST /auth/login - password incorrecta (401)",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Responde 401', () => pm.response.to.have.status(401));",
              "pm.test('Estado Credenciales invalidas', () => pm.expect(pm.response.json().estado).to.eql('Credenciales inválidas'));"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          { "key": "Content-Type", "value": "application/json" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"pedro@example.com\",\n  \"password\": \"passwordIncorrecta\"\n}"
        },
        "url": "{{baseUrl}}/auth/login"
      }
    },
    {
      "name": "POST /auth/login - email inexistente (401, mismo mensaje)",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Responde 401', () => pm.response.to.have.status(401));",
              "pm.test('No revela si el email existe', () => pm.expect(pm.response.json().estado).to.eql('Credenciales inválidas'));"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          { "key": "Content-Type", "value": "application/json" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"noexiste@example.com\",\n  \"password\": \"Admin123\"\n}"
        },
        "url": "{{baseUrl}}/auth/login"
      }
    },
    {
      "name": "POST /auth/login - falta campo requerido (400)",
      "request": {
        "method": "POST",
        "header": [
          { "key": "Content-Type", "value": "application/json" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"pedro@example.com\"\n}"
        },
        "url": "{{baseUrl}}/auth/login"
      }
    },
    {
      "name": "GET /auth/perfil - con token (200)",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "const cuerpo = pm.response.json();",
              "pm.test('Responde 200', () => pm.response.to.have.status(200));",
              "pm.test('Trae los datos del usuario logueado', () => {",
              "  pm.expect(cuerpo.datos).to.include.keys('id', 'nombre', 'apellido', 'email', 'rol', 'id_sede');",
              "});",
              "pm.test('Nunca expone la password', () => pm.expect(cuerpo.datos).to.not.have.property('password'));"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [
          { "key": "Authorization", "value": "Bearer {{token}}" }
        ],
        "url": "{{baseUrl}}/auth/perfil"
      }
    },
    {
      "name": "GET /auth/perfil - sin token (401)",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Responde 401', () => pm.response.to.have.status(401));",
              "pm.test('Estado Token no proporcionado', () => pm.expect(pm.response.json().estado).to.eql('Token no proporcionado'));"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "url": "{{baseUrl}}/auth/perfil"
      }
    },
    {
      "name": "GET /auth/perfil - token invalido (401)",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Responde 401', () => pm.response.to.have.status(401));",
              "pm.test('Estado Token invalido', () => pm.expect(pm.response.json().estado).to.eql('Token inválido'));"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [
          { "key": "Authorization", "value": "Bearer token.invalido.aqui" }
        ],
        "url": "{{baseUrl}}/auth/perfil"
      }
    }
  ]
}
